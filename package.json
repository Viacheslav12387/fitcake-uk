{
  "name": "fitcake-london",
  "version": "1.0.0",
  "private": true,
  "description": "Fit Cake London – static website (HTML, CSS, vanilla JS modules) with cart and online ordering.",
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "lint:html": "html-validate \"en/*.html\" \"pl/*.html\"",
    "check": "npm test && npm run lint:html",
    "start": "python3 -m http.server 8080"
  },
  "devDependencies": {
    "html-validate": "^8.18.2"
  },
  "engines": { "node": ">=20" }
}
